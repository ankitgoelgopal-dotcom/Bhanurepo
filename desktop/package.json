{
  "name": "freebrowser-desktop",
  "version": "1.0.0",
  "description": "FreeBrowser desktop",
  "main": "main.js",
  "author": "FreeBrowser",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.freebrowser.desktop",
    "productName": "FreeBrowser",
    "files": [
      "main.js",
      "preload.js",
      "ui.html",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "FreeBrowser.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "artifactName": "FreeBrowser.AppImage"
    }
  }
}